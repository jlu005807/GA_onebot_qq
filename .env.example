# OneBot 本地配置模板（复制为 .env 后使用）
#
# 取值规则：
# - 未加引号的值会被行尾注释截断，'#' 前需有空格或制表符：
#     ONEBOT_MAX_MSG_LENGTH=500   # 这里是注释    -> 500
#     ONEBOT_ACCESS_TOKEN=abc#def                -> abc#def（紧贴的 # 属于值）
# - 值里本身含 '#' 或需要保留首尾空格时，请加引号：
#     ONEBOT_PLAIN_TEXT_HINT="请用纯文本回复 #不要用markdown"
# - 环境变量优先于本文件。

# OneBot WebSocket 地址（必填）
ONEBOT_WS_URL=ws://127.0.0.1:8080/onebot/v11/ws

# 管理员 QQ（可选，多个用英文逗号分隔）
# 留空则不向 GA 注入管理员策略提示词
ONEBOT_ADMIN_QQ=123456789

# 允许使用的 QQ（可选，多个用英文逗号分隔）
# 使用 * 表示允许所有用户
ONEBOT_ALLOWED_USERS=*

# 是否启用群聊消息处理（可选）
# 1/true=启用，0/false=关闭
ONEBOT_ALLOW_GROUP=1

# 群聊白名单（可选，多个群号用英文逗号分隔）
# 使用 * 表示允许所有群
ONEBOT_ALLOWED_GROUPS=*

# 群聊触发模式（可选）
# 1/true：需要 @机器人 才触发（命中触发词也可触发）
# 0/false/留空：任意群消息都可触发
ONEBOT_GROUP_REQUIRE_AT=

# 群聊触发词（可选，多个用英文逗号分隔）
# 命中任意一个触发词即可触发回复
# 示例：ONEBOT_GROUP_TRIGGER_WORDS=小宇,助手,bot
ONEBOT_GROUP_TRIGGER_WORDS=

# 传递给 GA 的上下文消息条数（触发消息前 n 条）
# 0=关闭（与当前默认行为一致），最大 20
ONEBOT_CONTEXT_MESSAGES=0

# NapCat 访问令牌（可选）
ONEBOT_ACCESS_TOKEN=

# 纯文本提示词（可选）
# 设置为 0/false/off 可关闭
ONEBOT_PLAIN_TEXT_HINT=0

# 单条消息长度上限（可选）
ONEBOT_MAX_MSG_LENGTH=500

# 每个用户的待处理队列上限（可选）
ONEBOT_MAX_QUEUE_SIZE=5

# 附件保存目录（可选）
# 相对路径基于项目根目录解析（即本 .env 所在目录），与启动时的工作目录无关
ONEBOT_DATA_DIR=data

# 单个附件大小上限（可选，默认 10MB）
ONEBOT_MAX_FILE_BYTES=10485760

# 附件保留时长，单位小时（可选，默认 24）
# 超期附件会被后台定期清理；0=不清理（注意磁盘会一直增长）
ONEBOT_ATTACHMENT_TTL_HOURS=24

# 允许作为本地附件来源的目录白名单（可选，逗号分隔）
# 留空=不限制（保持默认行为）。填写后只接受这些目录下的文件，
# 用于在 OneBot 端不完全可信时限制 data.path 指向任意本地文件。
ONEBOT_LOCAL_SOURCE_DIRS=

# 单条回复的拆分长度上限（可选，默认 1500）
ONEBOT_SPLIT_LIMIT=1500

# 单实例互斥使用的本地端口（可选，默认 19529）
# 同机需要跑第二个实例时改成别的端口
ONEBOT_LOCK_PORT=19529

# 日志文件名（可选，默认 onebot.log）
# 实际文件会带启动时间戳，落在 temp/ 下
ONEBOT_LOG_FILE=onebot.log

# 保留最近多少个启动日志（可选，默认 10）
# 0=不清理
ONEBOT_LOG_KEEP=10
