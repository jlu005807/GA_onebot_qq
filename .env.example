# OneBot 本地设置（复制为 .env 使用）

# OneBot WebSocket 地址（必填）
ONEBOT_WS_URL=ws://127.0.0.1:8080/onebot/v11/ws

# 管理员 QQ（可选，多个用英文逗号分隔）
ONEBOT_ADMIN_QQ=123456789

# 允许使用的 QQ（可选，* 表示全部允许）
ONEBOT_ALLOWED_USERS=*

# 是否允许群聊（可选，默认允许）
ONEBOT_ALLOW_GROUP=1

# 群聊白名单（可选，* 表示全部允许）
ONEBOT_ALLOWED_GROUPS=*

# OneBot 访问令牌（可选，NapCat 未配置可留空）
ONEBOT_ACCESS_TOKEN=

# 纯文本提示词（可选，设为 0/false/off 可关闭）
ONEBOT_PLAIN_TEXT_HINT=0

# 单条消息长度上限（可选，默认 500）
ONEBOT_MAX_MSG_LENGTH=500

# 每个用户队列长度上限（可选，默认 5）
ONEBOT_MAX_QUEUE_SIZE=5

# 附件保存目录（可选，相对路径基于项目根目录）
# Attachment save directory (optional, relative path is based on current runtime directory)
ONEBOT_DATA_DIR=data

# 单文件大小上限（可选，默认 10MB）
ONEBOT_MAX_FILE_BYTES=10485760
