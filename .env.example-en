# OneBot local config template (copy to .env)
#
# Value rules:
# - Unquoted values are cut at an inline comment; the '#' must be preceded by
#   a space or tab:
#     ONEBOT_MAX_MSG_LENGTH=500   # a comment   -> 500
#     ONEBOT_ACCESS_TOKEN=abc#def              -> abc#def (adjacent # is data)
# - Quote the value when it contains '#' or needs leading/trailing spaces:
#     ONEBOT_PLAIN_TEXT_HINT="reply in plain text, no # markers"
# - Environment variables take precedence over this file.

# OneBot WebSocket URL (required)
ONEBOT_WS_URL=ws://127.0.0.1:8080/onebot/v11/ws

# Admin QQ(s), comma-separated (optional)
# Leave empty to disable admin policy prompt injection to GA
ONEBOT_ADMIN_QQ=123456789

# Allowed QQ users, comma-separated (optional)
# Use * to allow all users
ONEBOT_ALLOWED_USERS=*

# Enable group message handling (optional)
# 1/true=enable, 0/false=disable
ONEBOT_ALLOW_GROUP=1

# Allowed group IDs, comma-separated (optional)
# Use * to allow all groups
ONEBOT_ALLOWED_GROUPS=*

# Group trigger mode (optional)
# 1/true: must @bot to trigger (trigger words can also trigger)
# 0/false/empty: any group message can trigger
ONEBOT_GROUP_REQUIRE_AT=

# Group trigger words (optional), comma-separated
# Reply will trigger when any word is matched
# Example: ONEBOT_GROUP_TRIGGER_WORDS=xiaoyu,assistant,bot
ONEBOT_GROUP_TRIGGER_WORDS=

# Number of previous messages passed to GA as context
# 0=disabled (same as current default behavior), max 20
ONEBOT_CONTEXT_MESSAGES=0

# NapCat access token (optional)
ONEBOT_ACCESS_TOKEN=

# Extra plain text hint (optional)
# Set 0/false/off to disable
ONEBOT_PLAIN_TEXT_HINT=0

# Max length of a single incoming message (optional)
ONEBOT_MAX_MSG_LENGTH=500

# Max pending queue size per user (optional)
ONEBOT_MAX_QUEUE_SIZE=5

# Attachment save directory (optional)
# Relative path is resolved from the project root (the directory holding
# this .env), not from the shell's working directory
ONEBOT_DATA_DIR=data

# Max size per attachment in bytes (optional, default 10MB)
ONEBOT_MAX_FILE_BYTES=10485760

# Attachment retention in hours (optional, default 24)
# Expired attachments are swept periodically; 0 disables the sweep
# (disk then grows without bound)
ONEBOT_ATTACHMENT_TTL_HOURS=24

# Allowlist of directories accepted as local attachment sources
# (optional, comma-separated). Empty = no restriction (default behavior).
# Set it to stop a compromised OneBot backend from pointing data.path at
# an arbitrary local file.
ONEBOT_LOCAL_SOURCE_DIRS=

# Max length of one outgoing reply chunk (optional, default 1500)
ONEBOT_SPLIT_LIMIT=1500

# Local port used for the single-instance lock (optional, default 19529)
# Change it to run a second instance on the same machine
ONEBOT_LOCK_PORT=19529

# Log file name (optional, default onebot.log)
# The real file gets a startup timestamp and lands under temp/
ONEBOT_LOG_FILE=onebot.log

# How many startup logs to keep (optional, default 10). 0 disables pruning.
ONEBOT_LOG_KEEP=10
